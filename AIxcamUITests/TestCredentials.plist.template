<?xml version="1.0" encoding="UTF-8"?>
<!--
  TestCredentials.plist.template

  Credentials for the dedicated UI test account. Mirrors the Secrets.plist
  pattern: this .template is tracked, the real TestCredentials.plist is
  gitignored and never committed.

  Setup
  -----
  1. Firebase Console → project "aixcam" → Authentication → Users → Add user.
     Use a plus-tagged address you control, e.g. you+aixcamuitest@gmail.com,
     and a password of at least 8 characters.

  2. Seed the profile, or every authenticated test dead-ends in the setup form.
     ContentView gates the main tabs on ViewerProfile.isComplete, which needs a
     non-empty displayName and a birthdate at least 18 years back. The reliable
     way to create it is to sign in as the test user once by hand on a device
     and fill in the setup screen — that writes viewerProfiles/{uid} through the
     app's own code, so it is guaranteed to satisfy firestore.rules.

  3. Copy this file to TestCredentials.plist in the same directory and fill in
     the two values below.

  4. Add TestCredentials.plist to the AIxcamUITests target's
     "Copy Bundle Resources" build phase (drag it into the target in Xcode, or
     tick AIxcamUITests in the File Inspector's Target Membership).

  CI alternative
  --------------
  Instead of the plist, set the UITEST_EMAIL and UITEST_PASSWORD environment
  variables. They take precedence over this file. Do NOT put them in
  AIxcamUITests.xcscheme — that scheme is shared and tracked in git, so the
  password would be committed.

  When neither source is present the authenticated tests skip rather than fail,
  so the suite stays green for anyone without credentials.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>email</key>
	<string>REPLACE_ME@example.com</string>
	<key>password</key>
	<string>REPLACE_ME</string>
</dict>
</plist>
